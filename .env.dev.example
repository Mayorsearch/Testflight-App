# =============================================================================
# iMediaSave — DEVELOPMENT Environment
# =============================================================================
# Copy this file to .env.dev and fill in real values.
# NEVER commit files without the .example suffix to version control.
# =============================================================================

APP_ENV=dev
APP_NAME=iMediaSave Dev
APP_BUNDLE_ID=com.imediasave.app.dev
APP_VERSION_NAME=1.0.0

# API
API_BASE_URL=https://api-dev.imediasave.com
API_TIMEOUT_MS=30000

# Feature flags (1 = enabled, 0 = disabled)
FEATURE_ANALYTICS=0
FEATURE_CRASHLYTICS=0
FEATURE_PUSH_NOTIFICATIONS=1

# Sentry (optional crash reporting)
SENTRY_DSN=

# Firebase (optional — add if using Firebase services)
FIREBASE_PROJECT_ID=
