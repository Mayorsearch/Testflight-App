# =============================================================================
# iMediaSave — STAGING Environment
# =============================================================================
# Copy this file to .env.staging and fill in real values.
# NEVER commit files without the .example suffix to version control.
# =============================================================================

APP_ENV=staging
APP_NAME=iMediaSave Staging
APP_BUNDLE_ID=com.imediasave.app.staging
APP_VERSION_NAME=1.0.0

# API
API_BASE_URL=https://api-staging.imediasave.com
API_TIMEOUT_MS=30000

# Feature flags
FEATURE_ANALYTICS=1
FEATURE_CRASHLYTICS=1
FEATURE_PUSH_NOTIFICATIONS=1

# Sentry
SENTRY_DSN=

# Firebase
FIREBASE_PROJECT_ID=
