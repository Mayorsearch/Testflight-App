# =============================================================================
# iMediaSave — PRODUCTION Environment
# =============================================================================
# Copy this file to .env.prod and fill in real values.
# NEVER commit files without the .example suffix to version control.
# Store production secrets in GitHub Actions Secrets / CI environment only.
# =============================================================================

APP_ENV=prod
APP_NAME=iMediaSave
APP_BUNDLE_ID=com.imediasave.app
APP_VERSION_NAME=1.0.0

# API
API_BASE_URL=https://api.imediasave.com
API_TIMEOUT_MS=15000

# Feature flags
FEATURE_ANALYTICS=1
FEATURE_CRASHLYTICS=1
FEATURE_PUSH_NOTIFICATIONS=1

# Sentry
SENTRY_DSN=

# Firebase
FIREBASE_PROJECT_ID=
